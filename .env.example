NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_EXPECTED_HOSTNAME=bacha.petrvurm.cz
RESEND_API_KEY=
APP_ORIGIN=https://bacha.petrvurm.cz
# Optional comma-separated additional exact origins, for example a Vercel preview URL
ALLOWED_ORIGINS=
# Optional additional disposable-email domains (comma-separated); built-in includes anonmart.com
INTEREST_BLOCKED_EMAIL_DOMAINS=

# Firebase Admin SDK (server-only; never use NEXT_PUBLIC_ prefixes)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-example@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_VERCEL_SECRET\n-----END PRIVATE KEY-----\n"


# Backend-managed Google Sign-In – no FirebaseAuth client account creation.
# Must be the OAuth *Web* client ID requested by Android Credential Manager.
GOOGLE_OAUTH_WEB_CLIENT_ID=
# "closed": only explicit approved Google accounts can log in; empty allowlist rejects all.
BACHA_AUTH_MODE=closed
BACHA_AUTH_ALLOWED_GOOGLE_EMAILS=
# Only during transition from existing published FirebaseAuth-based Android builds.
# Set to 0 after migrating users and releasing backend-session APK.
BACHA_LEGACY_FIREBASE_AUTH=1

# Bacha! backend secrets (set values in Vercel project settings)
# Server-only OpenAI provider (never NEXT_PUBLIC_ or Android APK)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Stable random secret (>= 32 characters). Never rotate without migrating existing indicator lookup keys.
THREAT_INTEL_HMAC_SECRET=
WEB_RISK_API_KEY=
PHISHTANK_API_KEY=
URLHAUS_API_KEY=

# Google Play Android Publisher service account
PLAY_SERVICE_ACCOUNT_EMAIL=play-verifier@your-google-cloud-project.iam.gserviceaccount.com
PLAY_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_VERCEL_SECRET\n-----END PRIVATE KEY-----\n"

# Pub/Sub authenticated push OIDC verification
PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=bacha-rtdn-push@your-google-cloud-project.iam.gserviceaccount.com
PUBSUB_PUSH_AUDIENCE=https://bacha.petrvurm.cz/api/v1/billing/rtdn

# Vercel Cron authorization secret
CRON_SECRET=

# Optional local emulators (set Firebase SDK standard host variables)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
