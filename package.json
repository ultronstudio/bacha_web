{
  "name": "bacha-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bacha \"node --test --test-reporter=spec test/rules/*.test.js\"",
    "audit:critical": "npm audit --audit-level=critical",
    "audit:high": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check:client-secrets": "node scripts/check-client-secrets.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bootstrap": "5.3.8",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^11.3.2",
    "googleapis": "^189.0.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tldts": "^7.4.19"
  },
  "overrides": {
    "postcss": "8.5.23",
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.6",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.34.2",
    "typescript": "^5.9.2"
  }
}
